# Safe defaults: simulated feed, simulated classifier, and no real Bark delivery.
APP_ENV=development
APP_MODE=mock
DRY_RUN=true
PAID_API_CALLS_ENABLED=false
BARK_SEND_ENABLED=false

SOURCE_CONFIG_PATH=config/sources.toml
DB_PATH=data/arsenal-alert.sqlite3
MOCK_FEED_PATH=fixtures/mock_posts.json
MOCK_CLASSIFICATIONS_PATH=fixtures/mock_classifications.json
LOG_LEVEL=INFO
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
USAGE_RETENTION_DAYS=45

# X API. Re-check the official pricing page and Developer Console immediately
# before any live run, then update both the price and verification date.
X_API_BASE_URL=https://api.x.com
X_BEARER_TOKEN=
X_POLL_INTERVAL_SECONDS=60
X_INITIAL_LOOKBACK_MINUTES=120
X_OVERLAP_SECONDS=90
X_MAX_RESULTS=25
X_MAX_PAGES_PER_QUERY=5
X_MAX_REQUESTS_PER_HOUR=130
X_IDENTITY_RECHECK_HOURS=168
X_IDENTITY_RETRY_MINUTES=60
X_HTTP_TIMEOUT_SECONDS=20
X_MAX_ATTEMPTS=4
X_POST_READ_UNIT_USD=0.005
X_USER_READ_UNIT_USD=0.010
X_PRICE_VERIFIED_AT=
X_PRICE_MAX_AGE_DAYS=7
X_MONTHLY_BUDGET_USD=10.00
X_DEVELOPMENT_BUDGET_USD=2.00
X_ALERT_THRESHOLD_USD=8.00
X_BILLING_CYCLE_DAY=1

# DeepSeek OpenAI-compatible API. The values below matched the official docs
# on 2026-07-29; verify GET /models and current pricing before a live run.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_HTTP_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_ATTEMPTS=3
# Thinking materially improves nuanced transfer classification. Its reasoning tokens count
# toward max_tokens, so keep enough room for both reasoning and the final JSON object.
DEEPSEEK_THINKING_ENABLED=true
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_PRICE_VERIFIED_AT=
DEEPSEEK_PRICE_MAX_AGE_DAYS=30
DEEPSEEK_INPUT_CACHE_HIT_USD_PER_M=0.0028
DEEPSEEK_INPUT_CACHE_MISS_USD_PER_M=0.14
DEEPSEEK_OUTPUT_USD_PER_M=0.28

# Bark. A real notification is possible only when DRY_RUN=false and
# BARK_SEND_ENABLED=true. Keep the device key out of Git and logs.
BARK_BASE_URL=https://api.day.app
BARK_DEVICE_KEY=
# Optional override. Empty uses [club].notification_group from the source config.
BARK_GROUP=
BARK_LEVEL=active
BARK_SOUND=
BARK_HTTP_TIMEOUT_SECONDS=15
BARK_MAX_ATTEMPTS=4
BARK_RETRY_BASE_SECONDS=5

# Failed/invalid classifications are retried later and always fail closed.
CLASSIFICATION_MAX_ATTEMPTS=3
CLASSIFICATION_RETRY_BASE_SECONDS=30
